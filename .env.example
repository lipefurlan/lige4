# Supabase > Project Settings > API (ou "API Keys")
# URL do projeto
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chave pública (anon ou publishable). Vai para o browser: só permite leitura (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role ou secret). NUNCA use o prefixo NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: URL pública usada no QR code (ex.: https://lig4.vercel.app).
# Sem ela, o QR usa o endereço aberto no navegador.
NEXT_PUBLIC_SITE_URL=
